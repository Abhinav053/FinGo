# Auto-detect text files and normalize line endings on check-in
* text=auto

# Scripts must use LF on all platforms
*.sh text eol=lf
Makefile text eol=lf

# Go source
*.go text eol=lf

# TypeScript / JavaScript
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf

# Docs and config
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.env.example text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf

# Binary files — don't normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
